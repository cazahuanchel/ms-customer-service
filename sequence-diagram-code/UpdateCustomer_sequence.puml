'Descripción: actualización de clientes (PUT)
@startuml
title UpdateCustomer sequence
participant Customer
participant CustomerController
participant CustomerService
participant CustomerRepository as "CustomerRepository\n(MongoDB reactive)"

Customer -> CustomerController : PUT /customer\n{RequestBody}
activate CustomerController

CustomerController -> CustomerService : updateCustomer(Customer customer) : Completable
activate CustomerService

CustomerService -> CustomerRepository : findByIdReactive(id) : Single<Customer>
activate CustomerRepository
CustomerRepository --> CustomerService : Single<Customer> or Single.empty()
deactivate CustomerRepository

alt exists
  CustomerService -> CustomerRepository : save(Customer customer) : Completable
  activate CustomerRepository
  CustomerRepository --> CustomerService : Completable
  deactivate CustomerRepository

  CustomerService --> CustomerController : Completable (200 OK)
else not found
  CustomerService --> CustomerController : Completable (404 Not Found)
end

CustomerController --> Customer : 200 OK or 404 Not Found
deactivate CustomerController
deactivate CustomerService
@enduml