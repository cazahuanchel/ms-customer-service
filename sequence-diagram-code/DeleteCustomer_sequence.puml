'Descripción: eliminación lógica (recomendada) o física según política. Aquí muestro eliminación lógica (soft delete).
@startuml
title DeleteCustomer sequence
participant Customer
participant CustomerController
participant CustomerService
participant CustomerRepository as "CustomerRepository\n(MongoDB reactive)"

Customer -> CustomerController : DELETE /customer
activate CustomerController

CustomerController -> CustomerService : deleteCustomer(id) : Completable
activate CustomerService

CustomerService -> CustomerRepository : findById(id) : Mono<Customer>
activate CustomerRepository
CustomerRepository --> CustomerService : Mono<Customer> or Mono.empty()
deactivate CustomerRepository

alt exists
  CustomerService -> CustomerRepository : deleteById(String id) : Completable
  activate CustomerRepository
  CustomerRepository --> CustomerService : Completable
  deactivate CustomerRepository

  CustomerService --> CustomerController : Completable (204 No Content)
else not found
  CustomerService --> CustomerController : Completable (404 Not Found)
end

CustomerController --> Customer : 204 No Content or 404 Not Found
deactivate CustomerController
deactivate CustomerService
@enduml