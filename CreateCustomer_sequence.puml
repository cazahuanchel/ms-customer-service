@startuml
title CreateCustomer sequence
participant Customer
participant CustomerController
participant CustomerService
participant CustomerRepository as "CustomerRepository\n(MongoDB reactive)"
participant IdentityValidationService as "IdentityValidation\n(service, optional)"

Customer -> CustomerController : POST /customers\n{CustomerDTO}
activate CustomerController

CustomerController -> CustomerService : createCustomer(dto) : Mono<Customer>
activate CustomerService

' Business validations
CustomerService -> CustomerRepository : findByUniqueId(dto.idType, dto.idNumber) : Mono<Customer>
activate CustomerRepository
CustomerRepository --> CustomerService : Mono.empty() or Mono<Customer>
deactivate CustomerRepository

alt not exists
  CustomerService -> IdentityValidationService : validateIdentity(dto) : Mono<ValidationResult>
  activate IdentityValidationService
  IdentityValidationService --> CustomerService : Mono<ValidationResult>
  deactivate IdentityValidationService

  CustomerService -> CustomerRepository : insert(customerDocument) : Mono<Customer>
  activate CustomerRepository
  CustomerRepository --> CustomerService : Mono<Customer> (inserted)
  deactivate CustomerRepository

  CustomerService --> CustomerController : Mono<Customer> (201 Created)
else exists
  CustomerService --> CustomerController : Mono<Error> (409 Conflict)
end

CustomerController --> Customer : 201 Created or 409 Conflict
deactivate CustomerController
deactivate CustomerService
@enduml
